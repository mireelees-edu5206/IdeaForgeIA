# En desarrollo, Vite redirige /api al backend local. En Vercel, usa la URL HTTPS del túnel.
# Base de la API; en produccion debe terminar en /api/v1.
VITE_API_URL=/api/v1
# URL publica del proyecto Supabase Auth.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publishable publica; nunca colocar aqui la service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=PEGA_AQUI_TU_PUBLISHABLE_KEY
