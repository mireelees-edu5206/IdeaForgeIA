# Copiar a .env y ajustar. Nunca subir .env al repositorio.
APP_ENV=development
LOG_LEVEL=INFO
# Orígenes permitidos separados por comas (sin "*")
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (driver asyncpg). Si la contraseña tiene caracteres especiales, codificarlos en URL.
DATABASE_URL=postgresql+asyncpg://ideaforge:CAMBIAR@localhost:5432/ideaforge_dev
# Clave local antigua, solo necesaria si LEGACY_AUTH_ENABLED=true.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LEGACY_AUTH_ENABLED=false
# Supabase Auth: SUPABASE_URL va en backend y frontend; el JWT secret solo queda en backend.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=PEGA_AQUI_TU_PUBLISHABLE_KEY
SUPABASE_JWT_SECRET=
# Solo backend: permite eliminar la identidad de Supabase desde el panel admin.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional para usar una URL JWKS distinta a SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Bloqueo de login tras N intentos fallidos durante LOGIN_LOCKOUT_SECONDS
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# IA: fake simula resultados; Gemini usa la API externa y Ollama un servidor local.
AI_PROVIDER=fake
# Opcional: se usa solo si el proveedor principal falla y la operación se puede resolver sin web.
# AI_FALLBACK_PROVIDER=ollama
# Las búsquedas web con Google Search necesitan esta clave aunque AI_PROVIDER=ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SEARCH_GROUNDING_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_THINK=false
AI_TIMEOUT_SECONDS=240
AI_MAX_CONCURRENCY=3
AI_FAKE_LATENCY_MS=700
# Geodatos: Nominatim se consulta al enviar una búsqueda explícita, nunca como autocompletado.
GEO_PROVIDER=openstreetmap
GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_OVERPASS_URL=https://overpass-api.de/api/interpreter
GEO_USER_AGENT=IdeaForgeAI/0.1 (OpenStreetMap geocoding client)
# Investigación: preguntas por ejecución y ejecuciones por usuario cada 24 h
RESEARCH_MAX_QUESTIONS=8
RESEARCH_MAX_RUNS_PER_DAY=10

# BD exclusiva para tests de integración: se BORRA en cada ejecución. Debe terminar en _test.
TEST_DATABASE_URL=postgresql+asyncpg://ideaforge:CAMBIAR@localhost:5432/ideaforge_test
